#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { realpathSync } from "node:fs";
import { isAbsolute } from "node:path";
import { loopbackPorts } from "../container-ports.mjs";
const executable = process.env.BUILDTRAIL_REAL_PODMAN;
if (
  !executable ||
  !isAbsolute(executable) ||
  realpathSync(executable) === realpathSync(process.argv[1])
) {
  console.error(
    "Local container wrapper requires a distinct absolute Podman executable.",
  );
  process.exit(1);
}
const child = spawnSync(executable, loopbackPorts(process.argv.slice(2)), {
  stdio: "inherit",
  env: process.env,
});
if (child.error) console.error("Local container runtime could not start.");
process.exit(child.status ?? 1);
