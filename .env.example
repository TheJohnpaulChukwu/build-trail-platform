# Copy to .env. Local credentials are shown by the local Supabase CLI.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3001
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
RELEASE=development
REQUEST_TIMEOUT_MS=5000
PORT=3001
# No administrative key is needed by the backend identity read endpoints.
