{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "build-trail-platform",
  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": ["public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000,
    "auto_expose_new_tables": false,
  },
  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "major_version": 17,
    "seed": {
      "enabled": false,
    },
  },
  "auth": {
    "enabled": true,
    "site_url": "http://127.0.0.1:3001",
    "additional_redirect_urls": [],
    "enable_anonymous_sign_ins": false,
    "email": {
      "enabled": true,
      "enable_confirmations": true,
    },
  },
  "storage": {
    "enabled": false,
  },
  "realtime": {
    "enabled": false,
  },
  "studio": {
    "enabled": false,
  },
  "local_smtp": {
    "enabled": false,
  },
  "edge_runtime": {
    "enabled": false,
  },
  "analytics": {
    "enabled": false,
  },
}
